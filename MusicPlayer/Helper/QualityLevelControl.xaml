<UserControl x:Class="MusicPlayer.Helper.QualityLevelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MusicPlayer.Helper"
             xmlns:converters="clr-namespace:MusicPlayer.Converters"
             mc:Ignorable="d" 
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             d:DesignHeight="450" d:DesignWidth="800">
    
    <UserControl.Resources>
        <converters:QualityLevelToVisibilityConverter x:Key="QualityLevelToVisibilityConverter"/>
    </UserControl.Resources>
    
    <Grid>
        <StackPanel Orientation="Horizontal">
            <!-- HiRes徽标 - 高解析度音频：采样率≥96kHz，位深≥24bit -->
            <ui:TextBlock x:Name="HiRes" VerticalAlignment="Center" 
                          FontSize="10" FontWeight="SemiBold" Foreground="#FFF6B322" 
                          Text="HiRes" Margin="0,0,5,0"
                          Visibility="{Binding QualityLevel, RelativeSource={RelativeSource AncestorType=UserControl}, 
                                            Converter={StaticResource QualityLevelToVisibilityConverter}, 
                                            ConverterParameter=HiRes}" />
            
            <!-- SQ徽标 - 高品质音频：CD级音质（44.1-48kHz/16-24bit） -->
            <ui:TextBlock x:Name="SQ" VerticalAlignment="Center" 
                          FontSize="10" FontWeight="SemiBold" Foreground="#00BCD4" 
                          Text="SQ" Margin="0,0,5,0"
                          Visibility="{Binding QualityLevel, RelativeSource={RelativeSource AncestorType=UserControl}, 
                                            Converter={StaticResource QualityLevelToVisibilityConverter}, 
                                            ConverterParameter=SQ}" />
            
            <!-- HQ徽标 - 高品质：有损压缩格式或参数无法获取 -->
            <ui:TextBlock x:Name="HQ" VerticalAlignment="Center" 
                          FontSize="10" FontWeight="SemiBold" Foreground="#4CAF50" 
                          Text="HQ"
                          Visibility="{Binding QualityLevel, RelativeSource={RelativeSource AncestorType=UserControl}, 
                                            Converter={StaticResource QualityLevelToVisibilityConverter}, 
                                            ConverterParameter=HQ}" />
        </StackPanel>
    </Grid>
</UserControl>
